# ==============================================================================
# Environment Configuration Template for Multi-Hazard EEWS
# Copy this file to .env before starting docker compose:
#   cp .env.example .env
# ==============================================================================

# Google Earth Engine Cloud Project (Free academic/research tier)
GEE_PROJECT=multi-hazard-eews

# PostgreSQL / PostGIS Spatial Database
POSTGRES_DB=eews_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# FastAPI Backend Service
API_PORT=8000
LOG_LEVEL=INFO
EEWS_ADMIN_KEY=eews-super-secret-admin-key

# Next.js Dashboard Frontend Service
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Emergency Alert Channels (Phase 3 - 100% Free / Optional)
# Telegram Bot Dissemination (Free Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Email Dissemination (TLS/SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@eews-india.org
ALERT_EMAIL_RECIPIENTS=emergency-desk@ndma.gov.in

# SMS Broadcast (TRAI DLT Compliant - Disabled by default for zero telecom billing)
SMS_ENABLED=false
TRAI_PE_ID=1101554280000012345
TRAI_HEADER=NDMAEW
